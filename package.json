{
  "name": "spotdl-ytdlp-gui",
  "version": "2.14.0",
  "description": "Harbor: download and play music and video from YouTube, Spotify, SoundCloud and Apple Music",
  "main": "dist/main/main.js",
  "scripts": {
    "build:tsc": "tsc",
    "build:renderer": "node scripts/build-renderer.js",
    "build:icon": "electron scripts/build-icon.js",
    "build": "npm run build:tsc && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.js",
    "dist": "npm run build && node scripts/check-vendor.js && electron-builder --win nsis --publish never",
    "build:engine": "node scripts/build-engine.js"
  },
  "keywords": [
    "music-downloader",
    "video-downloader",
    "spotdl",
    "yt-dlp",
    "electron",
    "typescript"
  ],
  "author": "Protkan",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "motion": "^14.14.0",
    "typescript": "^5.7.2"
  },
  "homepage": "https://github.com/Protkan1/Harbor-Music-Downloader",
  "build": {
    "appId": "io.github.protkan1.harbor",
    "productName": "Harbor",
    "copyright": "Copyright © 2026 Protkan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "vendor/engine",
        "to": "engine"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Harbor",
      "artifactName": "Harbor-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Protkan1",
        "repo": "Harbor-Music-Downloader",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
